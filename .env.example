# charchat-lab 설정 예시. 이 파일을 .env로 복사해서 쓰세요.
# 값을 바꾼 뒤에는 서버를 다시 시작해야 해요. (화면의 '설정'에서 바꾼 값은 DB에 저장되어 이 기본값보다 우선해요)

# ── 시작할 때 쓸 제공사: mock | anthropic | gemini | openai_compat
PROVIDER=openai_compat

# ── Anthropic (Claude) ──────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5          # claude-sonnet-5-5, claude-opus-5-5 등
# 사고(thinking) 양: low | medium | high | xhigh | max. 롤플레이는 low가 빠르고 충분한 편이에요.
ANTHROPIC_EFFORT=low
# 사고 끄기(비우면 모델 기본값). Haiku 5.5는 disabled, Sonnet 5.5는 between_tools를 받아요. Opus 5.5는 끌 수 없어요.
# ANTHROPIC_THINKING=disabled
# 사고 토큰도 max_tokens에 포함되므로 최대 출력 토큰에 이만큼 더해서 보내요.
# ANTHROPIC_THINKING_HEADROOM=2048

# ── Google Gemini ───────────────────────────────────
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.8-flash
# 3.8 Flash는 low | medium | high (기본 medium). 2.5 계열 모델이면 이 줄을 지우세요.
GEMINI_THINKING_LEVEL=low
# GEMINI_THINKING_HEADROOM=2048
# 조정 가능한 안전 필터. 기본으로 꺼져 있는 필터를 명시적으로 켜요. DEFAULT로 두면 보내지 않아요.
# GEMINI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE

# ── OpenAI 호환 (Ollama, LM Studio, llama.cpp, vLLM, OpenAI) ──
# Ollama: http://localhost:11434/v1   LM Studio: http://localhost:1234/v1
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_MODEL= qwen3.5:4b		# ollama list에 나오는 모델 이름
# OPENAI_COMPAT_API_KEY=                    # 로컬 서버는 비워도 돼요
# 실제 OpenAI의 최신 모델은 max_completion_tokens를 요구할 수 있어요.
# OPENAI_COMPAT_MAX_TOKENS_PARAM=max_tokens
# 서버가 stream_options를 거부하면 false로 바꾸세요.
# OPENAI_COMPAT_STREAM_USAGE=true
# 추론형 모델의 사고 수준: none(끔) | low | medium | high. 비우면 보내지 않아요(모델 기본값).
# 작은 로컬 모델은 사고가 길고 답을 오히려 흐트러뜨리기 쉬워서 none을 권해요.
# OPENAI_COMPAT_REASONING_EFFORT=none
# 비우면 보내지 않아요. Ollama의 /v1은 top_p를 안 보내면 모델 기본값 대신 1.0을 써요.
# 모델 기본값은 `ollama show 모델이름 --parameters`로 확인하세요.
# OPENAI_COMPAT_TOP_P=0.95

# ── 요약과 LLM 검수에 쓸 모델(비우면 대화 모델을 그대로 써요) ──
# SUMMARY_MODEL=
# MODERATION_MODEL=

# ── 런타임 설정의 처음 기본값 ───────────────────────
# INPUT_TOKEN_BUDGET=6000
# MAX_OUTPUT_TOKENS=700
# WINDOW_STRATEGY=anchored                  # anchored | sliding | full
# SUMMARY_TRIGGER_RATIO=0.85
# SUMMARY_KEEP_RATIO=0.5
# CACHE_MODE=explicit                       # explicit | auto | off
# LORE_SCAN_DEPTH=4
# LORE_TOKEN_BUDGET=400
# MODERATION_MODE=block                     # block | log | off
# MODERATION_BACKEND=rules                  # rules | llm
# OUTPUT_BUFFER=sentence                    # sentence | none
# TEMPERATURE=                              # 비우면 기본값(현행 Claude 모델에는 보내지 않아요)

# ── mock 제공사 ─────────────────────────────────────
# MOCK_DELAY_SCALE=1.0                      # 0이면 지연 없이 바로 답해요
# MOCK_CACHE_MIN_TOKENS=512                 # 현행 Claude 모델의 캐시 최소 길이. 4096으로 바꾸면 Gemini 3.8 Flash처럼
# MOCK_CACHE_TTL_SECONDS=300
# MOCK_SEED=                                # 숫자를 넣으면 mock 답변이 매번 같은 순서로 나와요

# ── 토큰 추정: 한글 한 글자당 토큰 수 ───────────────
# 화면의 '추정 대비 실측' 값을 보고 맞추세요.
# TOKEN_HANGUL_RATIO=1.0

# ── 서버 ────────────────────────────────────────────
# HOST=127.0.0.1                            # 다른 기기에서 접속할 일이 없다면 그대로 두세요
# PORT=8000
# DATA_DIR=./data
